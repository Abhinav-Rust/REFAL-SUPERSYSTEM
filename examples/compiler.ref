$EXTERN Prout, Chr, Ord, Add, Compare, Upper;

* Refal-authored lexer + parser + checker + emitter for Classic Refal-5.
*
* The lexer is the same tokeniser as examples/lexer.ref, but it emits token
* TERMS rather than display text:
*   (Ident W)  (Num D)  (Str C)  (Var s X)
*   LP RP LB RB LA RA EQ SEMI COMMA COLON EXTERN ENTRY
* Refal-5 has no module system, so the two stages live in one file here rather
* than the parser importing the lexer. They will be merged into compiler.ref
* alongside the checker and emitter.
*
* The AST is printed by Prout, which renders structural brackets as
* parentheses:
*   (PROG item...)
*   (EXT name...)                        an $EXTERN declaration
*   (FUN (Ident Name) (VIS ENTRY) s...)  a function; VIS is ENTRY or LOCAL
*   (SENT (pattern...) (cond...) (result...))
*   (COND (expr...) (pattern...))
*   (SYM c) (ID Name) (NUM d) (Var s X) (BR term...) (CALL (ID N) term...)
*
* Grammar covered: $EXTERN, $ENTRY and local functions, multi-sentence
* functions, patterns, conditions (, expr : pattern), results, calls and
* structural brackets, blocks as sentence endings and in condition position,
* one-character variable shorthand, /* */ block comments and reals. Every
* example in examples/ that the Rust bootstrap will lower comes back
* byte-identical from this file -- see the corpus sweep test.

* The CLI runs Go, so Go is the compiler: it emits. Passing CHECK as a first
* argument asks for the checker's verdict instead, which is what the checker
* tests drive, GRAPH asks for the section 4.2 seed graph, RESIDUALIZE asks for
* the residual program the cleaned graph denotes, and DRIVE contracts the closed
* entry configuration.
*
* The mode that is *not* recognised gets its own sentence, and it is load
* bearing. A mode-shaped call -- two brackets -- that names nothing this file
* implements would otherwise reach the compile sentence below, which would try
* to parse `('MODE') (source)` as a program and spin. Reporting is the point: a
* bug in a stage must not look like a hang.
*
* A duplicate sentence printing a marker is NOT the way to do that, and this
* file used to carry three of them. Refal-5 does not fall through to the next
* sentence when a right-hand side fails -- `evaluate_sentences` returns the
* result of the selected sentence directly, and a probe confirms it: `Mid { =
* <Boom>; = 'caught'; }` reports `no sentence matched in function Boom` rather
* than reaching the second sentence. So a duplicate of the sentence above it is
* unreachable, and a stage failure is already loud. What is reachable is the
* case below: an argument shape no mode claims.
$ENTRY Go {
  ('CHECK') (e.Source) =
    <Prout <Check <Parse <Lex (<Chr 10>) <StripCR (<Chr 13>) e.Source>>>>>;
  ('GRAPH') (e.Source) =
    <Prout <Graph <Parse <Lex (<Chr 10>) <StripCR (<Chr 13>) e.Source>>>>>;
  ('RESIDUALIZE') (e.Source) =
    <Prout <Residualize <Parse <Lex (<Chr 10>) <StripCR (<Chr 13>) e.Source>>>>>;
  ('DRIVE') (e.Source) =
    <Prout <Drive <Parse <Lex (<Chr 10>) <StripCR (<Chr 13>) e.Source>>>>>;
  (e.Mode) (e.Source) = <Prout 'unknown mode: ' e.Mode>;
  (e.Source) = <Compile <Lex (<Chr 10>) <StripCR (<Chr 13>) e.Source>>>;
}

* Check first, and emit only what checks.
Compile {
  e.Tokens = <OnChecked <Check <Parse e.Tokens>> <Parse e.Tokens>>;
}

OnChecked {
  "OK" (PROG e.Items) = <Prout <Emit (PROG e.Items)>>;
  e.Msg (PROG e.Items) = <Prout e.Msg>;
}

* ---------------------------------------------------------------- lexer

* Carriage returns are not significant, but CRLF sources would otherwise lex
* a bare \r as an identifier.
StripCR {
  (e.CR) = ;
  (e.CR) e.CR e.R = <StripCR (e.CR) e.R>;
  (e.CR) s.C e.R = s.C <StripCR (e.CR) e.R>;
}

Lex {
  (e.NL) = ;
  (e.NL) " " e.R = <Lex (e.NL) e.R>;
  (e.NL) e.NL e.R = <Lex (e.NL) e.R>;
  (e.NL) '*' e.R = <SkipLine (e.NL) e.R>;
  (e.NL) '(' e.R = LP <Lex (e.NL) e.R>;
  (e.NL) ')' e.R = RP <Lex (e.NL) e.R>;
  (e.NL) '{' e.R = LB <Lex (e.NL) e.R>;
  (e.NL) '}' e.R = RB <Lex (e.NL) e.R>;
  (e.NL) '<' e.R = LA <Lex (e.NL) e.R>;
  (e.NL) '>' e.R = RA <Lex (e.NL) e.R>;
  (e.NL) '=' e.R = EQ <Lex (e.NL) e.R>;
  (e.NL) ';' e.R = SEMI <Lex (e.NL) e.R>;
  (e.NL) ',' e.R = COMMA <Lex (e.NL) e.R>;
  (e.NL) ':' e.R = COLON <Lex (e.NL) e.R>;
  (e.NL) '$EXTERNAL' e.R = EXTERN <Lex (e.NL) e.R>;
  (e.NL) '$EXTRN' e.R = EXTERN <Lex (e.NL) e.R>;
  (e.NL) '$ENTRY' e.R = ENTRY <Lex (e.NL) e.R>;
  (e.NL) '$EXTERN' e.R = EXTERN <Lex (e.NL) e.R>;
  (e.NL) 's.' e.R = <VarEmit (e.NL) ('s') <TakeWord (e.NL) () e.R>>;
  (e.NL) 't.' e.R = <VarEmit (e.NL) ('t') <TakeWord (e.NL) () e.R>>;
  (e.NL) 'e.' e.R = <VarEmit (e.NL) ('e') <TakeWord (e.NL) () e.R>>;
  (e.NL) "'" e.R = <StrTok (e.NL) ("'") () e.R>;
  (e.NL) '"' e.R = <StrTok (e.NL) ('"') () e.R>;
* One-character variable shorthand: s1, tA, eX. Identifiers cannot begin with a
* lower-case letter, so a leading s/t/e is always a variable. Juxtaposition
* falls out: s1s2s3 is three variables, because the next 's' starts a new one.
  (e.NL) 's' s.I e.R = (Var 's' s.I) <Lex (e.NL) e.R>;
  (e.NL) 't' s.I e.R = (Var 't' s.I) <Lex (e.NL) e.R>;
  (e.NL) 'e' s.I e.R = (Var 'e' s.I) <Lex (e.NL) e.R>;
  (e.NL) '/' '*' e.R = <SkipBlock (e.NL) e.R>;
  (e.NL) s.C e.R = <WordTok (e.NL) s.C e.R>;
}

* A block comment runs to the closing */, or to the end of the source.
SkipBlock {
  (e.NL) = ;
  (e.NL) '*' '/' e.R = <Lex (e.NL) e.R>;
  (e.NL) s.C e.R = <SkipBlock (e.NL) e.R>;
}

SkipLine {
  (e.NL) = ;
  (e.NL) e.NL e.R = <Lex (e.NL) e.R>;
  (e.NL) s.C e.R = <SkipLine (e.NL) e.R>;
}

TakeWord {
  (e.NL) (e.Acc) = (e.Acc);
  (e.NL) (e.Acc) " " e.R = (e.Acc) " " e.R;
  (e.NL) (e.Acc) e.NL e.R = (e.Acc) e.NL e.R;
  (e.NL) (e.Acc) '(' e.R = (e.Acc) '(' e.R;
  (e.NL) (e.Acc) ')' e.R = (e.Acc) ')' e.R;
  (e.NL) (e.Acc) '{' e.R = (e.Acc) '{' e.R;
  (e.NL) (e.Acc) '}' e.R = (e.Acc) '}' e.R;
  (e.NL) (e.Acc) '<' e.R = (e.Acc) '<' e.R;
  (e.NL) (e.Acc) '>' e.R = (e.Acc) '>' e.R;
  (e.NL) (e.Acc) '=' e.R = (e.Acc) '=' e.R;
* '.' is not a terminator: a real such as 12.5 or +4E2 is one token. The s./t./e.
* variable rules above have already taken the dot that separates kind from index.
  (e.NL) (e.Acc) ';' e.R = (e.Acc) ';' e.R;
  (e.NL) (e.Acc) ',' e.R = (e.Acc) ',' e.R;
  (e.NL) (e.Acc) ':' e.R = (e.Acc) ':' e.R;
  (e.NL) (e.Acc) "'" e.R = (e.Acc) "'" e.R;
  (e.NL) (e.Acc) '"' e.R = (e.Acc) '"' e.R;
  (e.NL) (e.Acc) '$' e.R = (e.Acc) '$' e.R;
  (e.NL) (e.Acc) s.C e.R = <TakeWord (e.NL) (e.Acc s.C) e.R>;
}

WordTok {
  (e.NL) s.C e.R, <IsDigit s.C> : '1' =
    <NumEmit (e.NL) <TakeWord (e.NL) (s.C) e.R>>;
  (e.NL) s.C e.R =
    <IdentEmit (e.NL) <TakeWord (e.NL) (s.C) e.R>>;
}

IsDigit {
  '0' = '1';
  '1' = '1';
  '2' = '1';
  '3' = '1';
  '4' = '1';
  '5' = '1';
  '6' = '1';
  '7' = '1';
  '8' = '1';
  '9' = '1';
  s.C = ;
}

VarEmit {
  (e.NL) (e.K) (e.W) e.Rest = (Var e.K e.W) <Lex (e.NL) e.Rest>;
}

NumEmit {
  (e.NL) (e.W) e.Rest = (Num e.W) <Lex (e.NL) e.Rest>;
}

IdentEmit {
  (e.NL) (e.W) e.Rest = (Ident e.W) <Lex (e.NL) e.Rest>;
}

StrTok {
  (e.NL) (e.Q) (e.Acc) = (Str e.Acc);
  (e.NL) (e.Q) (e.Acc) e.Q e.Q e.R = <StrTok (e.NL) (e.Q) (e.Acc e.Q) e.R>;
  (e.NL) (e.Q) (e.Acc) e.Q e.R = (Str e.Acc) <Lex (e.NL) e.R>;
  (e.NL) (e.Q) (e.Acc) s.C e.R = <StrTok (e.NL) (e.Q) (e.Acc s.C) e.R>;
}

* --------------------------------------------------------------- parser

Parse {
  e.Tokens = (PROG <Items e.Tokens>);
}

Items {
  = ;
* A semicolon may separate top-level definitions.
  SEMI e.Rest = <Items e.Rest>;
  EXTERN e.Rest = <JoinItem <OneExtern e.Rest>>;
  ENTRY e.Rest = <JoinItem <OneFun (VIS ENTRY) e.Rest>>;
  (Ident e.N) e.Rest = <JoinItem <OneFun (VIS LOCAL) (Ident e.N) e.Rest>>;
}

* e.Item holds the *contents* of the item bracket, so it must be re-wrapped.
* Emitting it flat drops the brackets and flattens the whole AST.
JoinItem {
  (e.Item) e.Rest = (e.Item) <Items e.Rest>;
}

OneExtern {
  e.Tokens = <OneExtern2 <Names () e.Tokens>>;
}

OneExtern2 {
  (e.Names) SEMI e.Rest = (EXT e.Names) e.Rest;
}

Names {
  (e.Acc) (Ident e.N) e.R = <Names (e.Acc (Ident e.N)) e.R>;
  (e.Acc) COMMA (Ident e.N) e.R = <Names (e.Acc (Ident e.N)) e.R>;
  (e.Acc) e.Rest = (e.Acc) e.Rest;
}

OneFun {
  (e.V) (Ident e.N) e.Tokens = <OneFun2 (e.V) (Ident e.N) <FunBody e.Tokens>>;
}

OneFun2 {
  (e.V) (Ident e.N) (e.Sents) e.Rest = (FUN (Ident e.N) (e.V) e.Sents) e.Rest;
}

FunBody {
  LB e.Tokens = <Sentences () e.Tokens>;
}

Sentences {
  (e.Acc) RB e.Rest = (e.Acc) e.Rest;
  (e.Acc) e.Tokens = <SentencesJoin (e.Acc) <Sentence e.Tokens>>;
}

SentencesJoin {
  (e.Acc) (e.Sent) e.Rest = <Sentences (e.Acc (e.Sent)) e.Rest>;
}

Sentence {
  e.Tokens = <Sent1 <Terms () e.Tokens>>;
}

Sent1 {
  (e.Pat) COMMA e.Rest = <SentCond (e.Pat) () e.Rest>;
  (e.Pat) EQ e.Rest = <SentRes (e.Pat) () e.Rest>;
}

* Sent1 has already consumed the comma that separates the pattern from the
* conditions, so SentCond starts on the condition's expression.
SentCond {
  (e.Pat) (e.Conds) e.Rest = <SentCond2 (e.Pat) (e.Conds) <Terms () e.Rest>>;
}

SentCond2 {
  (e.Pat) (e.Conds) (e.Expr) COLON e.Rest =
    <SentCond3 (e.Pat) (e.Conds) (e.Expr) <Terms () e.Rest>>;
}

SentCond3 {
  (e.Pat) (e.Conds) (e.Expr) () LB e.Rest =
    <SentCondBlk (e.Pat) (e.Conds) (e.Expr) <Sentences () e.Rest>>;
  (e.Pat) (e.Conds) (e.Expr) (e.CPat) COMMA e.Rest =
    <SentCond (e.Pat) (e.Conds (COND (e.Expr) (e.CPat))) e.Rest>;
  (e.Pat) (e.Conds) (e.Expr) (e.CPat) EQ e.Rest =
    <SentRes (e.Pat) (e.Conds (COND (e.Expr) (e.CPat))) e.Rest>;
}

* A block in condition position: `, expression : { sentences }`. The block's
* argument is the condition's expression, as it is in the Rust AST.
SentCondBlk {
  (e.Pat) (e.Conds) (e.Expr) (e.Sents) COMMA e.Rest =
    <SentCond (e.Pat) (e.Conds (COND (e.Expr) ((BLK (e.Expr) e.Sents)))) e.Rest>;
  (e.Pat) (e.Conds) (e.Expr) (e.Sents) EQ e.Rest =
    <SentRes (e.Pat) (e.Conds (COND (e.Expr) ((BLK (e.Expr) e.Sents)))) e.Rest>;
}

SentRes {
  (e.Pat) (e.Conds) COMMA e.Rest = <SentResBlock (e.Pat) (e.Conds) e.Rest>;
  (e.Pat) (e.Conds) e.Rest = <SentRes2 (e.Pat) (e.Conds) <Terms () e.Rest>>;
}

* A sentence-ending block: `= , argument : { sentences } ;`
SentResBlock {
  (e.Pat) (e.Conds) e.Rest = <SentResBlock2 (e.Pat) (e.Conds) <Terms () e.Rest>>;
}

SentResBlock2 {
  (e.Pat) (e.Conds) (e.Arg) COLON LB e.Rest =
    <SentResBlock3 (e.Pat) (e.Conds) (e.Arg) <Sentences () e.Rest>>;
}

* The block's closing brace is consumed by Sentences; the sentence's own
* semicolon still has to be taken here, as it is in the plain path.
SentResBlock3 {
  (e.Pat) (e.Conds) (e.Arg) (e.Sents) SEMI e.Rest =
    (SENT (e.Pat) (e.Conds) ((BLK (e.Arg) e.Sents))) e.Rest;
}

SentRes2 {
  (e.Pat) (e.Conds) (e.Res) SEMI e.Rest = (SENT (e.Pat) (e.Conds) (e.Res)) e.Rest;
}

* A term sequence stops at any token that cannot begin or continue a term.
Terms {
  (e.Acc) EQ e.R = (e.Acc) EQ e.R;
  (e.Acc) COMMA e.R = (e.Acc) COMMA e.R;
  (e.Acc) COLON e.R = (e.Acc) COLON e.R;
  (e.Acc) SEMI e.R = (e.Acc) SEMI e.R;
  (e.Acc) RB e.R = (e.Acc) RB e.R;
  (e.Acc) RP e.R = (e.Acc) RP e.R;
  (e.Acc) RA e.R = (e.Acc) RA e.R;
  (e.Acc) LB e.R = (e.Acc) LB e.R;
  (e.Acc) (Str e.C) e.R = <Terms (e.Acc <Chars e.C>) e.R>;
  (e.Acc) (Num e.D) e.R = <Terms (e.Acc (NUM e.D)) e.R>;
  (e.Acc) (Ident e.W) e.R = <Terms (e.Acc (ID e.W)) e.R>;
  (e.Acc) (Var e.K e.I) e.R = <Terms (e.Acc (VAR e.K e.I)) e.R>;
  (e.Acc) LP e.R = <TermsBr (e.Acc) e.R>;
  (e.Acc) LA e.R = <TermsCall (e.Acc) e.R>;
  (e.Acc) = (e.Acc);
}

* A quoted string is a sequence of character symbols, not one symbol.
Chars {
  = ;
  s.C e.R = (SYM s.C) <Chars e.R>;
}

TermsBr {
  (e.Acc) e.R = <TermsBr2 (e.Acc) <Terms () e.R>>;
}

TermsBr2 {
  (e.Acc) (e.Inner) RP e.R = <Terms (e.Acc (BR e.Inner)) e.R>;
}

TermsCall {
  (e.Acc) (Ident e.N) e.R = <TermsCall2 (e.Acc) (e.N) <Terms () e.R>>;
}

TermsCall2 {
  (e.Acc) (e.N) (e.Args) RA e.R = <Terms (e.Acc (CALL (ID e.N) e.Args)) e.R>;
}

* -------------------------------------------------------------- checker
*
* Prints OK when a program is well formed and a semicolon-separated diagnostic
* list otherwise. Checks today: the exported Go entry point, duplicate function
* names, and unbound variables in results.

Check {
  (PROG e.Items) = <Report <HasGo e.Items> <Dups (e.Items)> <Vars e.Items>>;
}

Report {
  = "OK";
  e.Msg = "ERRORS: " e.Msg;
}

* Refal-5 entry rule (reference A): execution starts from Go, and Go must be
* exported with $ENTRY.
* The parser stores a name as its characters, not as an identifier symbol, so
* the name is written here as the character literal 'Go'.
HasGo {
  (FUN (Ident 'Go') (VIS ENTRY) e.Sents) e.Rest = ;
  (FUN (Ident 'Go') (VIS LOCAL) e.Sents) e.Rest = "Go is defined but not exported with $ENTRY; ";
  t.Item e.Rest = <HasGo e.Rest>;
  = "the program must define an exported Go entry point; ";
}

* Duplicate function names.
*
* Detecting a duplicate is a question about a *set*, so it is answered by
* sorting: canonicalise each name once, sort the names, and look at neighbours.
* That is O(n log n).
*
* The pairwise pass below answers a different question -- it reports one message
* per ordered pair of equal names, so its *output* is quadratic in the number of
* colliding definitions and there is nothing to save there. It therefore runs
* only when the sorted scan has found a collision, which for a program the
* checker accepts is never.
*
* Why this matters and is not a micro-optimisation: the pairwise pass descends
* into both definitions' brackets for every pair, so on the compiler's own 201
* definitions it was 19.4 s of a 23.9 s self-hosting run -- 81% of it, and the
* only quadratic left in `Check`. Measured over synthetic corpora it is a clean
* O(n^2): 375 / 1425 / 6082 / 26062 ms at 50 / 100 / 200 / 400 definitions.
Dups {
  (e.Items) = <DupsWhen <AnyDup (<Sort <DupNameList (e.Items) ()>>)> (e.Items)>;
}

DupsWhen {
  () (e.Items) = ;
  (s.Any) (e.Items) = <DupsAll (e.Items)>;
}

* The canonical name of every function definition, in a list of its own.
* Names are compared under Classic Refal-5 name equivalence (reference 1.2.1):
* case folds and '-' is equivalent to '_'. FOO-BAR and FOO_BAR are one function.
DupNameList {
  () (e.Acc) = (e.Acc);
  ((FUN (Ident e.N) (e.V) e.Sents) e.Rest) (e.Acc) =
    <DupNameList (e.Rest) ((<Canon e.N>) e.Acc)>;
  (t.Item e.Rest) (e.Acc) = <DupNameList (e.Rest) (e.Acc)>;
}

* Merge sort. The list is split by dealing alternate elements, which needs no
* arithmetic on macrodigits and keeps every half the same length to within one.
*
* Convention, and it matters at every call: a function that takes a *list*
* takes it bracketed, and a function whose result is *spliced* into a larger
* expression returns the elements unwrapped. `Merge` is the second kind -- its
* result goes straight into `(e.K) <Merge ...>` -- so it returns an element
* sequence, and `Sort` brackets each half before handing it over. Getting this
* backwards costs a bracket level per merge, which reads as a wrong answer
* rather than as a crash.
Sort {
  () = ;
  ((e.X)) = (e.X);
  (e.L) = <Merge (<Sort <Fst <Split (e.L)>>>) (<Sort <Snd <Split (e.L)>>>)>;
}

Split {
  () = (() ());
  ((e.X)) = (((e.X)) ());
  ((e.A) (e.B) e.Rest) = <SplitJoin ((e.A)) ((e.B)) <Split (e.Rest)>>;
}

SplitJoin {
  (e.A) (e.B) ((e.X) (e.Y)) = ((e.A e.X) (e.B e.Y));
}

Merge {
  (e.A) () = e.A;
  () (e.B) = e.B;
  ((e.K) e.A) ((e.K2) e.B), <LeName (e.K) (e.K2)> : '1' =
    (e.K) <Merge (e.A) ((e.K2) e.B)>;
  ((e.K) e.A) ((e.K2) e.B) = (e.K2) <Merge ((e.K) e.A) (e.B)>;
}

Fst {
  ((e.A) (e.B)) = (e.A);
}

Snd {
  ((e.A) (e.B)) = (e.B);
}

LeName {
  () () = '1';
  () (e.B) = '1';
  (e.A) () = ;
  (s.X e.Rest) (s.Y e.More), <Compare <Ord s.X> <Ord s.Y>> : '-' = '1';
  (s.X e.Rest) (s.Y e.More), <Compare <Ord s.X> <Ord s.Y>> : '0' = <LeName (e.Rest) (e.More)>;
  (s.X e.Rest) (s.Y e.More) = ;
}

* True when two adjacent names in the sorted list are equal, which is exactly
* the condition under which a duplicate exists.
AnyDup {
  () = ();
  ((e.K)) = ();
  ((e.K) (e.K) e.Rest) = (1);
  ((e.K) (e.K2) e.Rest) = <AnyDup ((e.K2) e.Rest)>;
}

* One message per ordered pair of definitions with the same canonical name, in
* source order. Only reached when a collision exists.
DupsAll {
  () = ;
  ((FUN (Ident e.N) (e.V) e.Sents) e.Rest) =
    <DupName (e.N) (e.Rest)> <DupsAll (e.Rest)>;
  (t.Item e.Rest) = <DupsAll (e.Rest)>;
}

DupName {
  (e.N) () = ;
  (e.N) ((FUN (Ident e.M) (e.V) e.Sents) e.Rest),
    <EqName (<Canon e.N>) (<Canon e.M>)> : '1' = "duplicate function " e.M "; ";
  (e.N) (t.Item e.Rest) = <DupName (e.N) (e.Rest)>;
}

EqName {
  (e.A) (e.A) = '1';
  (e.A) (e.B) = ;
}

Canon {
  = ;
  '-' e.R = '_' <Canon e.R>;
  s.C e.R = <CanonChar s.C> <Canon e.R>;
}

* Folds A-Z to a-z by arithmetic rather than 26 sentences per case. Compare
* returns -, 0 or +, so the two tests are "below A" and "within A-Z".
CanonChar {
  s.C, <Ord s.C> : s.N, <Compare s.N 65> : '-' = s.C;
  s.C, <Ord s.C> : s.N, <Compare s.N 91> : '-' = <Chr <Add s.N 32>>;
  s.C = s.C;
}

Vars {
  = ;
  (FUN (Ident e.N) (e.V) e.Sents) e.Rest = <VarsSents e.Sents> <Vars e.Rest>;
  t.Item e.Rest = <Vars e.Rest>;
}

VarsSents {
  = ;
  (SENT (e.Pat) (e.Conds) (e.Res)) e.Rest = <VarsSent (e.Pat) (e.Conds) (e.Res)> <VarsSents e.Rest>;
  t.Item e.Rest = <VarsSents e.Rest>;
}

* A result variable must be bound by the sentence pattern or by the pattern of
* one of its conditions.
VarsSent {
  (e.Pat) (e.Conds) (e.Res) = <Unbound (e.Res) (<VarsOf e.Pat> <CondVars e.Conds>)>;
}

CondVars {
  = ;
  (COND (e.Expr) (e.CPat)) e.Rest = <VarsOf e.CPat> <CondVars e.Rest>;
}

* A variable record carries BOTH spellings: the source spelling is what a
* diagnostic must print, and the canonical spelling is what two variables must
* be compared by. Reference 1.3 makes e.Text and e.text the same variable, but
* the Rust bootstrap still reports `unbound variable e.Missing` as written, so
* folding the index at capture time silently corrupted the message.
VarsOf {
  = ;
  (VAR s.K e.I) e.Rest = (V s.K (e.I) (<Canon e.I>)) <VarsOf e.Rest>;
  (BR e.Inner) e.Rest = <VarsOf e.Inner> <VarsOf e.Rest>;
  (CALL (ID e.N) e.Args) e.Rest = <VarsOf e.Args> <VarsOf e.Rest>;
  t.Item e.Rest = <VarsOf e.Rest>;
}

Unbound {
  (e.Res) (e.Bound) = <UnboundVars <VarsOf e.Res> (e.Bound)>;
}

UnboundVars {
  (e.Bound) = ;
  (V s.K (e.I) (e.C)) e.Rest (e.Bound),
    <IsBound (V s.K (e.I) (e.C)) (e.Bound)> : '1' =
      <UnboundVars e.Rest (e.Bound)>;
  (V s.K (e.I) (e.C)) e.Rest (e.Bound) =
    "unbound variable " s.K "." e.I "; " <UnboundVars e.Rest (e.Bound)>;
}

* A bound record is a bracket holding several atoms (V, the kind, and the index
* characters), so it cannot be matched with `(t.V)`, which is a bracket holding
* exactly one term. Compare bracket contents instead.
* `e.V` holds the CONTENTS of the variable bracket, so the comparison has to
* re-wrap it as `(e.V)` before it can be matched against the bound record.
IsBound {
  (e.V) (t.Item e.Rest), <EqVar t.Item (e.V)> : '1' = '1';
  (e.V) (t.Item e.Rest) = <IsBound (e.V) (e.Rest)>;
  (e.V) () = ;
}

* Two variables are the same when the kind matches and the CANONICAL indices
* match. The source spellings deliberately take no part in the comparison.
EqVar {
  (V s.K (e.I) (e.C)) (V s.K (e.J) (e.C)) = '1';
  (e.A) (e.B) = ;
}

* --------------------------------------------------------------- emitter
*
* Emits Core Refal matching the Rust bootstrap's `refal lower` byte for byte:
*   $EXTERN a, b;            then a blank line, per declaration
*   $ENTRY Name {            sentences indented two spaces
*     pattern, expr : pat = result;
*   }                        a blank line between functions, one newline after

NL {
  = <Chr 10>;
}

Emit {
  (PROG e.Items) = <EmitDecls e.Items> <EmitFnList <OnlyFuns e.Items>>;
}

EmitDecls {
  = ;
  (EXT e.Names) e.Rest = "$EXTERN " <NameList e.Names> ";" <NL> <NL> <EmitDecls e.Rest>;
  t.Item e.Rest = <EmitDecls e.Rest>;
}

NameList {
  (Ident e.N) = e.N;
  (Ident e.N) e.Rest = e.N ", " <NameList e.Rest>;
}

OnlyFuns {
  = ;
  (FUN e.Body) e.Rest = (FUN e.Body) <OnlyFuns e.Rest>;
  t.Item e.Rest = <OnlyFuns e.Rest>;
}

* `refal lower` prints with print!, not println!, so the formatted program ends
* at the last closing brace with no trailing newline. Prout supplies the final
* newline, so the emitter must stop at '}' and put the blank line that separates
* two functions only between them.
EmitFnList {
  = ;
  (FUN e.Body) e.Rest = <EmitFun e.Body> <IfMore e.Rest>;
}

IfMore {
  = ;
  e.Rest = <NL> <NL> <EmitFnList e.Rest>;
}

EmitFun {
  (Ident e.N) (VIS ENTRY) e.Sents = "$ENTRY " e.N " {" <NL> <EmitSents ("  ") e.Sents> "}";
  (Ident e.N) (VIS LOCAL) e.Sents = e.N " {" <NL> <EmitSents ("  ") e.Sents> "}";
}

* Indentation is carried as a run of spaces rather than a count, so a nested
* block simply widens it by two and nesting works to any depth.
EmitSents {
  (e.Ind) = ;
  (e.Ind) (SENT (e.Pat) (e.Conds) (e.Res)) e.Rest =
    e.Ind <EmitTerms e.Pat> <EmitConds (e.Ind) e.Conds>
    <EmitSpace (e.Pat) (e.Conds)> "=" <EmitResult (e.Ind) (e.Res)> ";" <NL>
    <EmitSents (e.Ind) e.Rest>;
}

* A space before the = only when the pattern or a condition precedes it.
EmitSpace {
  () () = ;
  (e.Pat) (e.Conds) = " ";
}

* A result that is exactly one block renders as `, argument : { ... }`.
EmitResult {
  (e.Ind) () = ;
  (e.Ind) ((BLK (e.Arg) e.Sents)) =
    " ," <EmitBlkArg (e.Arg)> " : {" <NL>
    <EmitSents (e.Ind "  ") e.Sents> e.Ind "}";
  (e.Ind) (e.Res) = " " <EmitTerms e.Res>;
}

EmitBlkArg {
  () = ;
  (e.Arg) = " " <EmitTerms e.Arg>;
}

* A condition whose pattern is a block renders its body rather than terms.
EmitConds {
  (e.Ind) = ;
  (e.Ind) () = ;
  (e.Ind) (COND (e.Expr) ((BLK (e.BArg) e.Sents))) e.Rest =
    ", " <EmitTerms e.Expr> " : {" <NL>
    <EmitSents (e.Ind "  ") e.Sents> e.Ind "}" <EmitConds (e.Ind) e.Rest>;
  (e.Ind) (COND (e.Expr) (e.CPat)) e.Rest =
    ", " <EmitTerms e.Expr> " : " <EmitTerms e.CPat> <EmitConds (e.Ind) e.Rest>;
}

EmitTerms {
  = ;
  (SYM s.C) = <EmitChar s.C>;
  (SYM s.C) e.Rest = <EmitChar s.C> " " <EmitTerms e.Rest>;
  (ID e.N) = e.N;
  (ID e.N) e.Rest = e.N " " <EmitTerms e.Rest>;
  (NUM e.D) = e.D;
  (NUM e.D) e.Rest = e.D " " <EmitTerms e.Rest>;
  (VAR s.K e.I) = s.K "." e.I;
  (VAR s.K e.I) e.Rest = s.K "." e.I " " <EmitTerms e.Rest>;
  (BR e.Inner) = "(" <EmitTerms e.Inner> ")";
  (BR e.Inner) e.Rest = "(" <EmitTerms e.Inner> ") " <EmitTerms e.Rest>;
  (CALL (ID e.N) e.Args) = "<" e.N <EmitCallArgs e.Args> ">";
  (CALL (ID e.N) e.Args) e.Rest = "<" e.N <EmitCallArgs e.Args> "> " <EmitTerms e.Rest>;
}

EmitCallArgs {
  = ;
  e.Args = " " <EmitTerms e.Args>;
}

* A character is quoted with ' unless it is itself a quote, and then with ".
EmitChar {
  "'" = '"' "'" '"';
  s.C = "'" s.C "'";
}

* ------------------------------------------------------------------ graph
*
* Turchin 1980 4.2, the graph of states, built in Refal and printed
* byte-identically to the Rust bootstrap's `refal graph`. A state is a
* sentence, in program order; a transition is one call occurrence whose callee
* names a function that appears in the program; the entry is the state of Go.
* `refal graph` prints the graph after clean_unreachable_states, so the
* reachability cleanup and the renumbering it implies are reproduced here too,
* which is what makes the two comparable byte for byte.
*
* This is the first piece of the *transforming* half of the compiler -- the
* half Turchin's Chapter 4 makes the centre of compilation -- to be written in
* Refal rather than in refal-core. It reuses Lex and Parse exactly as the
* checker and the emitter do, so nothing is restated.
*
* One convention runs through the section, because getting it wrong fails
* silently: a function that walks a list takes the list SPREAD (one argument
* per element) and separates its base case by arity, while a function that
* wants a list as a single value takes it as one bracketed argument and
* destructures it with `(e.X)`. Choosing the wrong one binds the first element
* where the whole list was meant, which is a wrong answer rather than an error.

Graph {
  (PROG e.Items) = <FormatGraph <CleanG <BuildG e.Items>>>;
}

* ---- build the seed graph

BuildG {
  e.Items = <BuildG2 (<FlatStates e.Items>)>;
}

* One record per sentence, in program order: (name characters, sentence index,
* the sentence itself). The item is taken whole and destructured in FlatItem,
* because `e.Sents e.Rest` would be two adjacent e. variables and split
* shortest-first, leaving the recursion no argument to consume.
FlatStates {
  = ;
  t.Item e.Rest = <FlatItem t.Item> <FlatStates e.Rest>;
}

* A non-function item ($EXTERN) contributes no state and must not stall the
* walk, so the second sentence accepts any bracket at all.
FlatItem {
  (FUN (Ident e.N) (e.V) e.Sents) = <SPairs (e.N) 0 e.Sents>;
  (e.Any) = ;
}

SPairs {
  (e.N) s.I = ;
  (e.N) s.I t.Sent e.Rest = ((e.N) s.I t.Sent) <SPairs (e.N) <Add s.I 1> e.Rest>;
}

BuildG2 {
  (e.Pairs) = <BuildG3 (<StatesOf (e.Pairs)>) (<FirstsOf (e.Pairs)>)>;
}

* States carry ids 0,1,2... in program order.
StatesOf {
  (e.Pairs) = <StatesOf2 0 e.Pairs>;
}

StatesOf2 {
  s.I = ;
  s.I ((e.N) s.J t.Sent) e.Rest = (ST s.I (e.N) s.J t.Sent) <StatesOf2 <Add s.I 1> e.Rest>;
}

BuildG3 {
  (e.States) (e.Firsts) =
    (GR (<LookupGo (e.Firsts)>) (e.States) (<TransOf (e.States) (e.Firsts)>));
}

* first_states[uppercase(name)] = the function's first state id. A later
* function with the same name does not overwrite it, so the accumulator only
* ever grows and the lookup decides.
FirstsOf {
  (e.Pairs) = <FirstsL () <StatesOf (e.Pairs)>>;
}

FirstsL {
  (e.Acc) = e.Acc;
  (e.Acc) (ST s.Id (e.N) s.J t.Sent) e.Rest =
    <FirstsL <FirstAdd (e.Acc) (<Upper e.N>) s.Id> e.Rest>;
}

FirstAdd {
  (e.Acc) (e.U) s.Id = <FirstAdd2 (e.Acc) (e.U) s.Id <Lookup (e.Acc) (e.U)>>;
}

FirstAdd2 {
  (e.Acc) (e.U) s.Id s.P = (e.Acc);
  (e.Acc) (e.U) s.Id = (e.Acc ((e.U) s.Id));
}

Lookup {
  (e.Acc) (e.Q) = <LookupL e.Acc (e.Q)>;
}

* Key equality is exact after uppercasing, which is all build_seed_graph asks
* for: to_ascii_uppercase, with no '-'/'_' folding.
LookupL {
  (e.Q) = ;
  ((e.U) s.Id) e.Rest (e.Q), <SameChars (e.U) (e.Q)> : '1' = s.Id;
  (e.F) e.Rest (e.Q) = <LookupL e.Rest (e.Q)>;
}

LookupGo {
  (e.Firsts) = <LookupGoL e.Firsts>;
}

LookupGoL {
  = ;
  ((e.U) s.Id) e.Rest, <SameChars (e.U) ('GO')> : '1' = s.Id;
  (e.F) e.Rest = <LookupGoL e.Rest>;
}

SameChars {
  (e.A) (e.A) = '1';
  (e.A) (e.B) = ;
}

* ---- transitions: one per call occurrence, in term order

TransOf {
  (e.States) (e.Firsts) = <TransOf2 (e.Firsts) e.States>;
}

TransOf2 {
  (e.Firsts) = ;
  (e.Firsts) (ST s.Id (e.N) s.J t.Sent) e.Rest =
    <StateTrans s.Id (e.Firsts) <SentenceCalls t.Sent>> <TransOf2 (e.Firsts) e.Rest>;
}

StateTrans {
  s.Id (e.Firsts) = ;
  s.Id (e.Firsts) (e.Callee) e.Rest =
    <EmitTrans s.Id (e.Firsts) (e.Callee)> <StateTrans s.Id (e.Firsts) e.Rest>;
}

EmitTrans {
  s.Id (e.Firsts) (e.Callee) =
    <EmitTrans2 s.Id (e.Callee) <Lookup (e.Firsts) (<Upper e.Callee>)>>;
}

* A transition exists only when the callee names a function in the program, so
* a call to anything else produces none, and two identical calls are not
* deduplicated. The callee is emitted as written, not uppercased.
EmitTrans2 {
  s.Id (e.Callee) s.To = (TR s.Id (e.Callee) s.To);
  s.Id (e.Callee) = ;
}

* The order is the one collect_graph_state_call_names uses: the pattern, then
* for each condition its expression and then its pattern, then the result.
SentenceCalls {
  (SENT (e.Pat) (e.Conds) (e.Res)) = <TermCalls e.Pat> <CondCalls e.Conds> <TermCalls e.Res>;
}

CondCalls {
  = ;
  (COND (e.Expr) (e.CPat)) e.Rest = <TermCalls e.Expr> <TermCalls e.CPat> <CondCalls e.Rest>;
}

TermCalls {
  = ;
  t.Term e.Rest = <OneTermCalls t.Term> <TermCalls e.Rest>;
}

OneTermCalls {
  (SYM s.C) = ;
  (ID e.N) = ;
  (NUM e.D) = ;
  (VAR s.K e.I) = ;
  (BR e.Inner) = <TermCalls e.Inner>;
  (BLK (e.Arg) e.Sents) = <TermCalls e.Arg> <SentCalls e.Sents>;
  (CALL (ID e.N) e.Args) = (e.N) <TermCalls e.Args>;
  t.Other = ;
}

SentCalls {
  = ;
  t.Sent e.Rest = <SentenceCalls t.Sent> <SentCalls e.Rest>;
}

* ---- clean: keep only what the entry can reach (clean_unreachable_states)

CleanG {
  (GR (e.Entry) (e.States) (e.Trans)) = <CleanG2 (e.Entry) (e.States) (e.Trans)>;
}

CleanG2 {
  () (e.States) (e.Trans) = (CG () () ());
  (s.E) (e.States) (e.Trans) =
    <Renumber2 (e.Trans) s.E <RenumS 0 () () (<Reach s.E (e.States) (e.Trans)>) e.States>>;
}

* Breadth-first from the entry. From a state the walk reaches every state of
* the same function, by case-insensitive name, and every transition target.
Reach {
  s.E (e.States) (e.Trans) = <ReachLoop (s.E) () (e.States) (e.Trans)>;
}

ReachLoop {
  () (e.Seen) (e.States) (e.Trans) = e.Seen;
  (s.Id e.Q) (e.Seen) (e.States) (e.Trans), <Member s.Id (e.Seen)> : '1' =
    <ReachLoop (e.Q) (e.Seen) (e.States) (e.Trans)>;
  (s.Id e.Q) (e.Seen) (e.States) (e.Trans) =
    <ReachLoop <Enqueue (e.Q) <Successors s.Id (e.States) (e.Trans)>> (s.Id e.Seen) (e.States) (e.Trans)>;
}

Enqueue {
  (e.Q) = (e.Q);
  (e.Q) s.X e.Rest = <Enqueue (e.Q s.X) e.Rest>;
}

Successors {
  s.Id (e.States) (e.Trans) = <SameFunc s.Id (e.States)> <TransFrom s.Id e.Trans>;
}

SameFunc {
  s.Id (e.States) = <SameFunc2 <FuncName s.Id e.States> (e.States)>;
}

FuncName {
  s.Id = ;
  s.Id (ST s.Id (e.N) s.J t.Sent) e.Rest = (e.N);
  s.Id (e.S) e.Rest = <FuncName s.Id e.Rest>;
}

SameFunc2 {
  (e.N) (e.States) = <SameFunc3 (<Upper e.N>) e.States>;
}

SameFunc3 {
  (e.U) = ;
  (e.U) (ST s.Id (e.M) s.J t.Sent) e.Rest, <SameChars (<Upper e.M>) (e.U)> : '1' =
    s.Id <SameFunc3 (e.U) e.Rest>;
  (e.U) (e.S) e.Rest = <SameFunc3 (e.U) e.Rest>;
}

TransFrom {
  s.Id = ;
  s.Id (TR s.Id (e.Callee) s.To) e.Rest = s.To <TransFrom s.Id e.Rest>;
  s.Id (e.T) e.Rest = <TransFrom s.Id e.Rest>;
}

Member {
  s.X (e.S) = <MemberL s.X e.S>;
}

MemberL {
  s.X = ;
  s.X s.X e.Rest = '1';
  s.X s.Y e.Rest = <MemberL s.X e.Rest>;
}

* Renumber the reachable states 0,1,2... in program order and carry the
* remapping into the transitions; an edge with an unmapped endpoint is the one
* that led to a state which was removed.
RenumS {
  s.Next (e.Map) (e.New) (e.Reach) = (RS (e.Map) (e.New));
  s.Next (e.Map) (e.New) (e.Reach) (ST s.Id (e.N) s.J t.Sent) e.Rest,
    <Member s.Id (e.Reach)> : '1' =
      <RenumS <Add s.Next 1> (e.Map (RM s.Id s.Next)) (e.New (ST s.Next (e.N) s.J t.Sent)) (e.Reach) e.Rest>;
  s.Next (e.Map) (e.New) (e.Reach) (ST s.Id (e.N) s.J t.Sent) e.Rest =
      <RenumS s.Next (e.Map) (e.New) (e.Reach) e.Rest>;
}

Renumber2 {
  (e.Trans) s.E (RS (e.Map) (e.New)) =
    (CG (<LookupM (e.Map) s.E>) (e.New) (<RenumT (e.Map) e.Trans>));
}

LookupM {
  (e.Map) s.X = <LookupML e.Map s.X>;
}

LookupML {
  s.X = ;
  (RM s.X s.N) e.Rest s.X = s.N;
  (e.R) e.Rest s.X = <LookupML e.Rest s.X>;
}

RenumT {
  (e.Map) = ;
  (e.Map) (TR s.F (e.Callee) s.T) e.Rest,
    <LookupM (e.Map) s.F> : s.NF,
    <LookupM (e.Map) s.T> : s.NT =
      (TR s.NF (e.Callee) s.NT) <RenumT (e.Map) e.Rest>;
  (e.Map) (e.T) e.Rest = <RenumT (e.Map) e.Rest>;
}

* ---- print: `format_seed_graph`, with the final newline left to Prout

FormatGraph {
  (CG () (e.States) (e.Trans)) = "entry: <none>" <FmtTail (e.States) (e.Trans)>;
  (CG (s.E) (e.States) (e.Trans)) = "entry: S" s.E <FmtTail (e.States) (e.Trans)>;
}

FmtTail {
  (e.States) (e.Trans) = <FmtStates e.States> <FmtTrans e.Trans>;
}

FmtStates {
  = ;
  (ST s.Id (e.N) s.J t.Sent) e.Rest = <NL> "S" s.Id " = " e.N "#" s.J <FmtStates e.Rest>;
}

FmtTrans {
  = ;
  (TR s.F (e.Callee) s.T) e.Rest = <NL> "S" s.F " -" e.Callee "-> S" s.T <FmtTrans e.Rest>;
}

* ------------------------------------------------------------- residualize
*
* The cleaned graph denotes a program, and emitting that program is the first
* stage of the transforming half that produces *source* rather than a report.
* `refal residualize-graph` is lower -> build_seed_graph ->
* clean_unreachable_states -> residualize_cleaned_graph -> format_program, and
* this reproduces the last two steps on top of the Graph stage above, reusing the
* emitter that already matches `refal lower` byte for byte.
*
* residualize_cleaned_graph walks the ORIGINAL program's functions in order and
* keeps, for each, the surviving states whose function name matches
* case-insensitively. A function with no surviving sentence disappears, which is
* the reachability dead-code elimination that cleaning performed: in
* `metacode-chapter6.ref` the function Echo is named only inside a quoted string,
* nothing calls it, and it is not in the residue. Declarations ($EXTERN) are
* carried through untouched, and a function's visibility comes from the program
* rather than from the graph, because a state does not record it.
*
* The sentences come out in state order, which is program order, which is the
* span order residualize_cleaned_graph sorts by. So the rebuilt PROG differs from
* the source PROG in exactly one respect -- the functions cleaning removed -- and
* the emitter renders it byte-identically to `refal residualize-graph`.

Residualize {
  (PROG e.Items) = <Emit (PROG <ResidItems (<CleanG <BuildG e.Items>>) e.Items>)>;
}

* The graph is carried bracketed and last, because a function that survives needs
* it again for the next item. A list returned unwrapped spreads across the
* caller's arguments -- the bug that hid the seed graph's firsts table.
ResidItems {
  (e.G) = ;
  (e.G) (EXT e.Names) e.Rest = (EXT e.Names) <ResidItems (e.G) e.Rest>;
  (e.G) (FUN (Ident e.N) (e.V) e.Sents) e.Rest =
    <ResidFun (e.N) (e.V) (e.G) (e.Rest)>;
  (e.G) t.Other e.Rest = <ResidItems (e.G) e.Rest>;
}

ResidFun {
  (e.N) (e.V) (e.G) (e.Rest) =
    <ResidFun2 (e.N) (e.V) (e.G) (e.Rest) <ResidSents (e.N) e.G>>;
}

* A function whose every sentence cleaning removed is not emitted at all: its
* sentences are gone from the graph, so there is nothing left to print. An empty
* FUN would not be Refal, which is why the case is separate from the general one.
* The surviving sentences arrive *bracketed*, because an unbracketed list of
* length zero is indistinguishable from an absent argument -- `() ` would then
* never match and every dropped function would come out as an empty `F { }`.
ResidFun2 {
  (e.N) (e.V) (e.G) (e.Rest) () = <ResidItems (e.G) e.Rest>;
  (e.N) (e.V) (e.G) (e.Rest) (e.Sents) =
    (FUN (Ident e.N) (e.V) e.Sents) <ResidItems (e.G) e.Rest>;
}

ResidSents {
  (e.N) (CG (e.Entry) (e.States) (e.Trans)) = (<ResidSents2 (<Upper e.N>) e.States>);
}

* Name equality is exact after uppercasing, which is what
* residualize_cleaned_graph asks for with eq_ignore_ascii_case on ASCII names.
ResidSents2 {
  (e.U) = ;
  (e.U) (ST s.Id (e.M) s.J t.Sent) e.Rest, <SameChars (<Upper e.M>) (e.U)> : '1' =
    t.Sent <ResidSents2 (e.U) e.Rest>;
  (e.U) (e.S) e.Rest = <ResidSents2 (e.U) e.Rest>;
}

* ------------------------------------------------------------------ drive
*
* Section 4.2's other half. The graph says which sentences exist; driving says
* which of them a configuration actually reaches, by contracting calls until
* nothing is left to contract. This reproduces `refal drive`, which is
* drive_ground over the closed entry configuration <Go>: every selected sentence
* is recorded as a visited state, and the fully instantiated result is printed.
*
* The semantics are refal-core's, not the runtime's, and one difference is
* visible in the output: Prout is *not* a printer here, it is the identity.
* drive_ground special-cases it to return its argument, so `output:` is the
* value the program computed rather than what it printed.
*
* Two conventions run through the section, both of them responses to traps this
* repository has paid for.
*
* 1. Every list is passed BRACKETED. A function that appends to a list can then
*    do so without an adjacent e-variable splitting shortest-first and binding
*    empty, which is the silent hang; and "no list" is a different shape from
*    "empty list" when it matters.
* 2. Every computed result is passed FIRST, never last after a spread list. A
*    trailing spread list followed by a pattern term is matched by trying the
*    shortest split first, which works but backtracks over the whole list; a
*    result in first position cannot be misread at all.
*
* The step counter is threaded through *failures* as well as successes, because
* that is what the Rust driver does: `match_ground_conditions` mutates `self`
* before it returns false, so a sentence whose condition fails still costs the
* steps its condition expression spent. `condition-block.ref` is the case that
* makes this observable -- its condition calls `Approve`, and the reported step
* count only comes out right if that call is counted once per attempt.

Drive {
  (PROG e.Items) = <DriveRun <CleanG <BuildG e.Items>>>;
}

DriveRun {
  (CG () (e.States) (e.Trans)) = "entry: <none>";
  (CG (s.E) (e.States) (e.Trans)) =
    <DriveEntry (e.States) <DvNameOf s.E (e.States)>>;
}

* The entry is a state id; the driver needs the function that state belongs to.
DvNameOf {
  s.E () = (NONE);
  s.E ((ST s.E (e.N) s.J t.Sent) e.Rest) = (SOME (e.N));
  s.E (e.S) e.Rest = <DvNameOf s.E e.Rest>;
}

DriveEntry {
  (e.States) (NONE) = "entry: <none>";
  (e.States) (SOME (e.Fn)) =
    <DriveOut <DvInvoke (CTX (e.States) 0 ()) (e.Fn) ()>>;
}

DriveOut {
  (OK (e.Out) (CTX (e.States) s.Steps (e.Visited))) =
    "steps: " s.Steps <NL>
    "visited: " <DvVis (e.Visited)> <NL>
    "output: " <EmitTerms e.Out>;
  (e.Err) = "drive error";
}

DvVis {
  () = ;
  (s.Id) = "S" s.Id;
  (s.Id e.Rest) = "S" s.Id " -> " <DvVis (e.Rest)>;
}

* ---- contraction

* The context is (CTX <states> <steps> <visited>). It is threaded through every
* evaluation, including the ones that fail, because the step count is a property
* of the whole walk and not of the successful path through it.
DvInvoke {
  (e.Ctx) (e.Fn) (e.In) = <DvInvokeGo (e.Ctx) (e.Fn) (e.In) <DvProut (e.Fn)>>;
}

DvInvokeGo {
  (CTX (e.States) s.Steps (e.Visited)) (e.Fn) (e.In) '1' =
    (OK (e.In) (CTX (e.States) <Add s.Steps 1> (e.Visited)));
  (CTX (e.States) s.Steps (e.Visited)) (e.Fn) (e.In), <Compare s.Steps 10000> : '-' =
    <DvSent (CTX (e.States) <Add s.Steps 1> (e.Visited)) (e.Fn) (e.In) e.States>;
  (e.Ctx) (e.Fn) (e.In) = (ERR (STEPLIMIT));
}

DvProut {
  (e.Fn) = <SameChars (<Upper e.Fn>) ('PROUT')>;
}

* States are tried in order and the first whose pattern and conditions hold
* wins. The state list is spread, so "no states left" is an arity, not a
* sentinel.
DvSent {
  (e.Ctx) (e.Fn) (e.In) = <DvNoSent (e.Fn)>;
  (e.Ctx) (e.Fn) (e.In) (ST s.Id (e.N) s.J t.Sent) e.Rest,
    <SameChars (<Upper e.N>) (<Upper e.Fn>)> : '1' =
      <DvState (e.Ctx) (e.Fn) (e.In) s.Id t.Sent e.Rest>;
  (e.Ctx) (e.Fn) (e.In) (ST s.Id (e.N) s.J t.Sent) e.Rest =
      <DvSent (e.Ctx) (e.Fn) (e.In) e.Rest>;
}

DvNoSent {
  (e.Fn) = (ERR (NOSENTENCE));
}

DvState {
  (e.Ctx) (e.Fn) (e.In) s.Id (SENT (e.Pat) (e.Conds) (e.Res)) e.Rest =
    <DvState2 <DvMatch (e.Pat) (e.In) ()> (e.Ctx) (e.Fn) (e.In) s.Id (e.Conds) (e.Res) e.Rest>;
}

DvState2 {
  (OK (e.B)) (e.Ctx) (e.Fn) (e.In) s.Id (e.Conds) (e.Res) e.Rest =
    <DvState3 <DvConds (e.Ctx) (e.B) (e.Conds)> (e.Ctx) (e.Fn) (e.In) s.Id (e.Res) e.Rest>;
  (NO) (e.Ctx) (e.Fn) (e.In) s.Id (e.Conds) (e.Res) e.Rest =
    <DvSent (e.Ctx) (e.Fn) (e.In) e.Rest>;
}

* The state is recorded BEFORE its result is instantiated, which is why a
* recursive function's own state appears once per turn.
DvState3 {
  (OK (e.B2) (CTX (e.States) s.Steps (e.Visited))) (e.Ctx) (e.Fn) (e.In) s.Id (e.Res) e.Rest =
    <DvInst (CTX (e.States) s.Steps (e.Visited s.Id)) (e.B2) (e.Res)>;
  (NO (e.Ctx1)) (e.Ctx) (e.Fn) (e.In) s.Id (e.Res) e.Rest =
    <DvSent (e.Ctx1) (e.Fn) (e.In) e.Rest>;
}

* ---- conditions

* (OK <bindings> <ctx>) or (NO <ctx>). A condition's expression is instantiated
* first -- and may invoke -- and only then is its pattern matched against the
* value.
DvConds {
  (e.Ctx) (e.B) () = (OK (e.B) (e.Ctx));
  (e.Ctx) (e.B) ((COND (e.Expr) ((BLK (e.Arg) e.Sents))) e.More) =
    <DvCondsBlk (e.Ctx) (e.B) (e.Arg) (e.Sents) (e.More)>;
  (e.Ctx) (e.B) ((COND (e.Expr) (e.CPat)) e.More) =
    <DvCondsVal <DvInst (e.Ctx) (e.B) (e.Expr)> (e.Ctx) (e.B) (e.CPat) (e.More)>;
}

DvCondsVal {
  (OK (e.Val) (e.Ctx1)) (e.Ctx) (e.B) (e.CPat) (e.More) =
    <DvCondsPat <DvMatch (e.CPat) (e.Val) (e.B)> (e.Ctx1) (e.B) (e.More)>;
  (e.Err) (e.Ctx) (e.B) (e.CPat) (e.More) = (NO (e.Ctx));
}

DvCondsPat {
  (OK (e.B2)) (e.Ctx) (e.B) (e.More) = <DvConds (e.Ctx) (e.B2) (e.More)>;
  (NO) (e.Ctx) (e.B) (e.More) = (NO (e.Ctx));
}

DvCondsBlk {
  (e.Ctx) (e.B) (e.Arg) (e.Sents) (e.More) =
    <DvCondsBlk2 <DvInst (e.Ctx) (e.B) (e.Arg)> (e.Ctx) (e.B) (e.Sents) (e.More)>;
}

DvCondsBlk2 {
  (OK (e.Val) (e.Ctx1)) (e.Ctx) (e.B) (e.Sents) (e.More) =
    <DvCondsBlk3 <DvBlkTest (e.Ctx1) (e.B) (e.Val) (e.Sents)> (e.B) (e.More)>;
  (e.Err) (e.Ctx) (e.B) (e.Sents) (e.More) = (NO (e.Ctx));
}

DvCondsBlk3 {
  (OK (e.Ctx)) (e.B) (e.More) = <DvConds (e.Ctx) (e.B) (e.More)>;
  (NO (e.Ctx)) (e.B) (e.More) = (NO (e.Ctx));
}

* A block in condition position is an anonymous function applied to the value:
* the condition holds exactly when one of the block's sentences matches. The
* bindings a block makes stay inside it, which is why the block is tested
* against the enclosing bindings but never writes back to them.
DvBlkTest {
  (e.Ctx) (e.B) (e.Val) (e.Sents) = <DvBlkTestL (e.Ctx) (e.B) (e.Val) (e.Sents)>;
}

DvBlkTestL {
  (e.Ctx) (e.B) (e.Val) () = (NO (e.Ctx));
  (e.Ctx) (e.B) (e.Val) ((SENT (e.Pat) (e.Conds) (e.Res)) e.More) =
    <DvBlkTest2 <DvMatch (e.Pat) (e.Val) (e.B)> (e.Ctx) (e.B) (e.Val) (e.Conds) (e.More)>;
}

DvBlkTest2 {
  (OK (e.B2)) (e.Ctx) (e.B) (e.Val) (e.Conds) (e.More) =
    <DvBlkTest3 <DvConds (e.Ctx) (e.B2) (e.Conds)> (e.B) (e.Val) (e.More)>;
  (NO) (e.Ctx) (e.B) (e.Val) (e.Conds) (e.More) =
    <DvBlkTestL (e.Ctx) (e.B) (e.Val) (e.More)>;
}

DvBlkTest3 {
  (OK (e.B3) (e.Ctx)) (e.B) (e.Val) (e.More) = (OK (e.Ctx));
  (NO (e.Ctx)) (e.B) (e.Val) (e.More) = <DvBlkTestL (e.Ctx) (e.B) (e.Val) (e.More)>;
}

* ---- instantiation

* (OK <terms> <ctx>) or an error. A call is instantiated by instantiating its
* arguments, invoking, and splicing the result in place; a variable by its
* binding; a bracket by recursing inside it.
DvInst {
  (e.Ctx) (e.B) (e.Terms) = <DvInstL (e.Ctx) (e.B) (e.Terms)>;
}

DvInstL {
  (e.Ctx) (e.B) () = (OK () (e.Ctx));
  (e.Ctx) (e.B) (t.T e.Rest) = <DvInstOne (e.Ctx) (e.B) t.T (e.Rest)>;
}

DvInstOne {
  (e.Ctx) (e.B) (VAR s.K e.I) (e.Rest) =
    <DvInstVar <DvLookup (e.B) (<Canon e.I>)> (e.Ctx) (e.B) (e.Rest)>;
  (e.Ctx) (e.B) (BR e.Inner) (e.Rest) = <DvInstBr (e.Ctx) (e.B) (e.Inner) (e.Rest)>;
  (e.Ctx) (e.B) (CALL (ID e.N) e.Args) (e.Rest) =
    <DvInstCall (e.Ctx) (e.B) (e.N) (e.Args) (e.Rest)>;
  (e.Ctx) (e.B) (BLK (e.Arg) e.Sents) (e.Rest) =
    <DvInstBlk (e.Ctx) (e.B) (e.Arg) (e.Sents) (e.Rest)>;
  (e.Ctx) (e.B) t.T (e.Rest) = <DvInstJoin (t.T) <DvInstL (e.Ctx) (e.B) (e.Rest)>>;
}

DvInstVar {
  (SOME (e.V)) (e.Ctx) (e.B) (e.Rest) = <DvInstL (e.Ctx) (e.B) (e.V e.Rest)>;
  (NONE) (e.Ctx) (e.B) (e.Rest) = (ERR (UNBOUND));
}

DvInstBr {
  (e.Ctx) (e.B) (e.Inner) (e.Rest) =
    <DvInstBr2 <DvInst (e.Ctx) (e.B) (e.Inner)> (e.B) (e.Rest)>;
}

DvInstBr2 {
  (OK (e.In) (e.Ctx)) (e.B) (e.Rest) =
    <DvInstJoin ((BR e.In)) <DvInstL (e.Ctx) (e.B) (e.Rest)>>;
  (e.Err) (e.B) (e.Rest) = (e.Err);
}

DvInstCall {
  (e.Ctx) (e.B) (e.N) (e.Args) (e.Rest) =
    <DvInstCall2 <DvInst (e.Ctx) (e.B) (e.Args)> (e.B) (e.N) (e.Rest)>;
}

DvInstCall2 {
  (OK (e.ArgsOut) (e.Ctx)) (e.B) (e.N) (e.Rest) =
    <DvInstCall3 <DvInvoke (e.Ctx) (e.N) (e.ArgsOut)> (e.B) (e.Rest)>;
  (e.Err) (e.B) (e.N) (e.Rest) = (e.Err);
}

DvInstCall3 {
  (OK (e.Out) (e.Ctx)) (e.B) (e.Rest) =
    <DvInstJoin (e.Out) <DvInstL (e.Ctx) (e.B) (e.Rest)>>;
  (e.Err) (e.B) (e.Rest) = (e.Err);
}

DvInstBlk {
  (e.Ctx) (e.B) (e.Arg) (e.Sents) (e.Rest) =
    <DvInstBlk2 <DvInst (e.Ctx) (e.B) (e.Arg)> (e.B) (e.Sents) (e.Rest)>;
}

DvInstBlk2 {
  (OK (e.Val) (e.Ctx)) (e.B) (e.Sents) (e.Rest) =
    <DvInstBlk3 <DvBlkRun (e.Ctx) (e.B) (e.Val) (e.Sents)> (e.B) (e.Rest)>;
  (e.Err) (e.B) (e.Sents) (e.Rest) = (e.Err);
}

DvInstBlk3 {
  (OK (e.Out) (e.Ctx)) (e.B) (e.Rest) =
    <DvInstJoin (e.Out) <DvInstL (e.Ctx) (e.B) (e.Rest)>>;
  (e.Err) (e.B) (e.Rest) = (e.Err);
}

* A block in RESULT position is different from one in condition position: this
* one's matched sentence result is instantiated and its value returned.
DvBlkRun {
  (e.Ctx) (e.B) (e.Val) (e.Sents) = <DvBlkRunL (e.Ctx) (e.B) (e.Val) (e.Sents)>;
}

DvBlkRunL {
  (e.Ctx) (e.B) (e.Val) () = (ERR (BLOCK));
  (e.Ctx) (e.B) (e.Val) ((SENT (e.Pat) (e.Conds) (e.Res)) e.More) =
    <DvBlkRun2 <DvMatch (e.Pat) (e.Val) (e.B)> (e.Ctx) (e.B) (e.Val) (e.Conds) (e.Res) (e.More)>;
}

DvBlkRun2 {
  (OK (e.B2)) (e.Ctx) (e.B) (e.Val) (e.Conds) (e.Res) (e.More) =
    <DvBlkRun3 <DvConds (e.Ctx) (e.B2) (e.Conds)> (e.B) (e.Val) (e.Res) (e.More)>;
  (NO) (e.Ctx) (e.B) (e.Val) (e.Conds) (e.Res) (e.More) =
    <DvBlkRunL (e.Ctx) (e.B) (e.Val) (e.More)>;
}

DvBlkRun3 {
  (OK (e.B3) (e.Ctx)) (e.B) (e.Val) (e.Res) (e.More) = <DvInst (e.Ctx) (e.B3) (e.Res)>;
  (NO (e.Ctx)) (e.B) (e.Val) (e.Res) (e.More) = <DvBlkRunL (e.Ctx) (e.B) (e.Val) (e.More)>;
}

DvInstJoin {
  (e.Emit) (OK (e.Out) (e.Ctx)) = (OK (e.Emit e.Out) (e.Ctx));
  (e.Emit) (e.Err) = (e.Err);
}

* ---- matching, the ground case

* match_ground_pattern, with the same backtracking and the same search order:
* an e-variable tries the LONGEST prefix first, an s- or t-variable has exactly
* one candidate and it must be a single term. (e.X) (e.Y) is where that order
* shows, and it is the Rust matcher's order, not the runtime's.
DvMatch {
  (e.Pat) (e.In) (e.B) = <DvMatchL <DvFirst (e.Pat)> (e.In) (e.B)>;
}

DvMatchL {
  (NONE) (e.In) (e.B) = <DvMatchEnd (e.In) (e.B)>;
  (SOME t.P (e.PRest)) (e.In) (e.B) = <DvMatchTerm t.P (e.PRest) (e.In) (e.B)>;
}

DvMatchEnd {
  () (e.B) = (OK (e.B));
  t.X (e.B) = (NO);
}

DvMatchTerm {
  (VAR s.K e.I) (e.PRest) (e.In) (e.B) = <DvMatchVar s.K (e.I) (e.PRest) (e.In) (e.B)>;
  t.P (e.PRest) (e.In) (e.B) = <DvMatchLit t.P (e.PRest) (e.In) (e.B)>;
}

DvMatchLit {
  t.P (e.PRest) (e.In) (e.B) = <DvMatchLit2 <DvFirst (e.In)> t.P (e.PRest) (e.B)>;
}

DvMatchLit2 {
  (NONE) t.P (e.PRest) (e.B) = (NO);
  (SOME t.Q (e.IRest)) t.P (e.PRest) (e.B) =
    <DvMatchLit3 <DvGround t.P t.Q> (e.PRest) (e.IRest) (e.B)>;
}

DvMatchLit3 {
  '1' (e.PRest) (e.IRest) (e.B) = <DvMatch (e.PRest) (e.IRest) (e.B)>;
  (e.PRest) (e.IRest) (e.B) = (NO);
}

DvMatchVar {
  s.K (e.I) (e.PRest) (e.In) (e.B) =
    <DvVarTryL <DvVarCands s.K (e.In)> s.K (e.I) (e.PRest) (e.In) (e.B)>;
}

* The candidate list is a BRACKET holding split brackets, not a spread list:
* a spread list handed to a function whose base case is "no candidates" cannot
* tell "empty" from "absent", and the first version of this wrapped it once too
* often so the head pattern never matched at all.
DvVarCands {
  'e' (e.In) = <DvRev (<DvSplits (e.In)>)>;
  's' (e.In) = <DvOneCand (e.In)>;
  't' (e.In) = <DvOneCand (e.In)>;
}

* Every prefix/suffix split, shortest prefix first.
DvSplits {
  (e.In) = <DvSplits2 () (e.In)>;
}

DvSplits2 {
  (e.Pre) (e.Suf) = ((e.Pre) (e.Suf)) <DvSplits3 (e.Pre) (e.Suf)>;
}

DvSplits3 {
  (e.Pre) () = ;
  (e.Pre) (t.X e.Rest) = <DvSplits2 (e.Pre t.X) (e.Rest)>;
}

DvRev {
  (e.Splits) = <DvRevL (e.Splits) ()>;
}

* The accumulator is passed as a BRACKET and bound by its contents, so the
* recursive construction `(t.X e.Acc)` prepends a term to the list instead of
* appending a bracket to it. Binding it as a bracket and constructing with it
* adds the bracket itself as a term, which is how the first version turned the
* empty tail into a stray `()` that no later pattern matched.
DvRevL {
  () (e.Acc) = (e.Acc);
  (t.X e.Rest) (e.Acc) = <DvRevL (e.Rest) (t.X e.Acc)>;
}

DvOneCand {
  () = ();
  (t.X e.Rest) = (((t.X) (e.Rest)));
}

DvVarTryL {
  () s.K (e.I) (e.PRest) (e.In) (e.B) = (NO);
  (((e.Pre) (e.Suf)) e.More) s.K (e.I) (e.PRest) (e.In) (e.B) =
    <DvVarCand <DvVarOk s.K (e.Pre)> s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More)>;
}

DvVarOk {
  'e' (e.Pre) = '1';
  't' (e.Pre) = <DvSingle (e.Pre)>;
  's' (e.Pre) = <DvSymbol (e.Pre)>;
}

* An `s.` binds any symbol -- a character, a number or an identifier -- but
* never a bracket. A `t.` binds any single term, bracket included (reference
* 1.3).
DvSingle {
  (t.X) = '1';
  (e.A) = ;
}

DvSymbol {
  ((SYM s.C)) = '1';
  ((ID e.N)) = '1';
  ((NUM e.D)) = '1';
  (e.A) = ;
}

DvVarCand {
  '1' s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More) =
    <DvVarBind <DvLookup (e.B) (<Canon e.I>)> s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More)>;
  s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More) =
    <DvVarTryL (e.More) s.K (e.I) (e.PRest) (e.In) (e.B)>;
}

DvVarBind {
  (NONE) s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More) =
    <DvVarAccept <DvMatch (e.PRest) (e.Suf) (e.B (VE (<Canon e.I>) (e.Pre)))>
      s.K (e.I) (e.PRest) (e.In) (e.B) (e.More)>;
  (SOME (e.Old)) s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More) =
    <DvVarRep <SameChars (e.Old) (e.Pre)> s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More)>;
}

* A repeated variable must bind the same terms everywhere it occurs, so the
* existing binding is reused rather than replaced.
DvVarRep {
  '1' s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More) =
    <DvVarAccept <DvMatch (e.PRest) (e.Suf) (e.B)> s.K (e.I) (e.PRest) (e.In) (e.B) (e.More)>;
  s.K (e.I) (e.PRest) (e.In) (e.B) (e.Pre) (e.Suf) (e.More) =
    <DvVarTryL (e.More) s.K (e.I) (e.PRest) (e.In) (e.B)>;
}

DvVarAccept {
  (OK (e.B2)) s.K (e.I) (e.PRest) (e.In) (e.B) (e.More) = (OK (e.B2));
  (NO) s.K (e.I) (e.PRest) (e.In) (e.B) (e.More) =
    <DvVarTryL (e.More) s.K (e.I) (e.PRest) (e.In) (e.B)>;
}

DvGround {
  (SYM s.A) (SYM s.B) = <SameChars (s.A) (s.B)>;
  (ID e.A) (ID e.B) = <SameChars (<Upper e.A>) (<Upper e.B>)>;
  (NUM e.A) (NUM e.B) = <SameChars (e.A) (e.B)>;
  (BR e.A) (BR e.B) = <DvMatched <DvMatch (e.A) (e.B) ()>>;
  t.X t.Y = ;
}

DvMatched {
  (OK (e.B)) = '1';
  (NO) = ;
}

* ---- small list utilities

DvFirst {
  () = (NONE);
  (t.X e.Rest) = (SOME t.X (e.Rest));
}

DvLookup {
  (e.B) (e.Key) = <DvLookupL (e.B) (e.Key)>;
}

DvLookupL {
  () (e.Key) = (NONE);
  ((VE (e.K) (e.V)) e.Rest) (e.Key), <SameChars (e.K) (e.Key)> : '1' = (SOME (e.V));
  (t.F e.Rest) (e.Key) = <DvLookupL (e.Rest) (e.Key)>;
}
