/* Associativity of recursive Append, expressed through a shared condition
   binding. SCP4 (1999, section 4) uses associativity as a theorem example.

   A condition value must finish evaluating before it can be matched. Different
   symbolic expressions do not establish unequal results, and a possible match
   must not be discarded in favor of the False fallback. Unresolved equality or
   expression-split choices remain pending during specialization and proof.

   Execution comparisons retain True for the source and both compiler paths.
   Predicate checks cover small budgets and require that an unresolved case
   cannot become a false refutation. The recursive Append sentence precedes
   the base case so that non-empty symbol sequences exercise recursion. */

$EXTERN Prout;

$ENTRY Go {
  e.Input = <Prout <Law e.Input>>;
}

/* Both computations must satisfy the same condition binding. */
Law {
  e.X e.Y e.Z,
    <Append <Append e.X e.Y> e.Z> : e.Both,
    <Append e.X <Append e.Y e.Z>> : e.Both = 'True';
  e.X e.Y e.Z = 'False';
}

/* `Append`, recursive: the head case first, the empty base case last, so that the
   recursive sentence is the one that fires on a non-empty left list. */
Append {
  s.Head e.Tail e.Rest = s.Head <Append e.Tail e.Rest>;
  e.Rest = e.Rest;
}
