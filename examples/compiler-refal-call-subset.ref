$EXTERN Prout;

* Restricted source grammar: Name = <Callee e.Input>; Callee = e.Input;
* The repeated Callee name is checked by Refal pattern matching.
$ENTRY Go {
  (e.Name " = <" e.Callee " e.Input>; " e.Callee " = e.Input;") =
    <Prout "$ENTRY Go { e.Input = <" e.Name " e.Input>; } " e.Name " { e.Input = <" e.Callee " e.Input>; } " e.Callee " { e.Input = e.Input; }">;
}

