/* Partial recursive reversal: Rev(Rev(T)) = T is undefined outside Rev's
   domain. Rev-Left on (Node Foo Foo) fails in a recursive Rev call, while
   Rev-Right returns that value. Execution regressions retain this witness.

   Recursive folding requires evidence that field bindings belong to the
   function's domain. Pending computations and ambiguous expression splits
   remain unresolved during specialization. The equivalence search may finish
   open or exhaust its budget; neither outcome establishes the claim.

   The total reversal in examples/equiv-tree-reversal.ref supplies a separate
   positive proof example. */

$EXTERN Prout;

$ENTRY Go {
  e.Input = <Prout <Rev e.Input>>;
}

Rev-Left {
  e.T = <Rev <Rev e.T>>;
}

Rev-Right {
  e.T = e.T;
}

Rev {
  (Leaf) = (Leaf);
  (Node e.L e.R) = (Node <Rev e.R> <Rev e.L>);
}
